# Copy to .env.local for local development, and set the same keys in Vercel → Settings → Environment Variables.

# Public site URL (used in notification emails)
NEXT_PUBLIC_SITE_URL=https://www.condaxits.com

# Neon Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Vercel Blob (Vercel dashboard → Storage → Blob → token)
BLOB_READ_WRITE_TOKEN=

# Resend (https://resend.com) — optional but recommended for instant alerts
RESEND_API_KEY=
# After you verify your domain in Resend, use e.g. Condax <support@condaxits.com>
RESEND_FROM=Condax <support@condaxits.com>
CAREERS_TO=admin@condaxits.com
CONTACT_TO=support@condaxits.com

# Password for /admin/applications
ADMIN_PASSWORD=condax-dev-admin
# Optional: dedicated signing secret for admin cookies (recommended in production)
# ADMIN_SESSION_SECRET=long-random-string

# Optional but recommended: Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# When both are set, Contact / Referral / Careers forms require the widget.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Local testing without Neon/Blob:
# - In `next dev`, applications + CVs are stored under .data/ automatically if DATABASE_URL / BLOB are missing.
# - For LAN partner testing: npm run dev:lan  →  share http://YOUR_LAN_IP:3000
